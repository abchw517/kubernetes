#!/usr/bin/env bash
set -euo pipefail

raw=("$@")
if [[ -n "${MOCK_KUBECTL_LOG:-}" ]]; then
  printf '%s\n' "${raw[*]}" >> "${MOCK_KUBECTL_LOG}"
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --request-timeout=*|--kubeconfig=*) shift ;;
    *) break ;;
  esac
done

case "${1:-}" in
  version)
    exit 0
    ;;
  config)
    [[ "${2:-}" == "view" ]] || exit 2
    cat "${MOCK_FIXTURE_DIR}/admin-config-view.json"
    ;;
  create)
    [[ "${2:-}" == "token" ]] || exit 2
    echo 'eyJhbGciOiJSUzI1NiJ9.eyJzdWIiOiJzeXN0ZW06c2VydmljZWFjY291bnQ6cG9kLXN0YXJ0LXRpbWUtY2hlY2stc3lzdGVtOnBvZC1zdGFydC10aW1lLWNoZWNrIn0.signature'
    ;;
  auth)
    [[ "${2:-}" == "can-i" ]] || exit 2
    verb="${3:-}"
    resource="${4:-}"
    if [[ "${MOCK_RBAC_ERROR:-0}" == "1" ]]; then exit 1; fi
    if [[ "${MOCK_PRIVILEGED:-0}" == "1" && "$verb" == "*" && "$resource" == "*" ]]; then
      echo yes
      exit 0
    fi
    case "${verb}:${resource}" in
      list:pods|list:replicasets.apps) echo yes ;;
      *) echo no ;;
    esac
    ;;
  get)
    case "${2:-}" in
      pods) cat "${MOCK_FIXTURE_DIR}/pods.json" ;;
      replicasets.apps) cat "${MOCK_FIXTURE_DIR}/replicasets.json" ;;
      *) exit 1 ;;
    esac
    ;;
  *)
    exit 2
    ;;
esac
